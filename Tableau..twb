      <column caption='Shipping Time' datatype='integer' name='[Calculation_0670769976008704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos; ,[Order Date],[Ship Date])' />
      </column>
      <column caption='profit margin' datatype='real' name='[Calculation_1072091672694784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Profit vs Loss' datatype='string' name='[Calculation_1072091679588353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit]&gt;0 then &quot;Profit&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
